# Copy to .env and fill in. .env is never committed (see .gitignore).

# ---- database (Supabase: Project Settings > Database > Connection string > URI, port 5432)
DATABASE_URL=
# or the parts instead of DATABASE_URL:
# DB_HOST= DB_PORT=5432 DB_NAME= DB_USER= DB_PASSWORD=
SUPABASE_URL=
SUPABASE_KEY=
# run migrations at start-up (set 0 when a deploy step runs them)
AUTO_MIGRATE=1

# ---- web app
HOST=localhost
PORT=3000
# long random string: signs login cookies and email links. REQUIRED in production.
SECRET_KEY=
# 1 when the site is served over https (production)
SESSION_COOKIE_SECURE=0
# 1 behind a reverse proxy (nginx, Caddy…) that serves https, so links use https and the real host
TRUST_PROXY=0
# timezone used for exam dates in forms, e.g. Africa/Douala
APP_TIMEZONE=UTC

# ---- admins: comma separated; they must log in with Google to act as admin
ADMIN_EMAILS=

# ---- Google sign-in (Google Cloud console > Credentials > OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# only to force a callback address (behind a proxy); normally leave empty
GOOGLE_CALLBACK_URL=

# ---- email (Resend)
RESEND_API_KEY=
MAIL_FROM=Studiamo <onboarding@resend.dev>

# ---- files written by the app (production data: back them up)
MARKDOWN_DIR=data/md
MEDIA_DIR=data/media

# ---- users' own AI API keys (Claude, Gemini, OpenAI) are encrypted with this (else SECRET_KEY).
# Keep it stable: changing it makes saved keys unreadable.
AI_KEYS_SECRET=
